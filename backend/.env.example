# Copy to .env and fill in real values. Never commit the real .env.

# Supabase — service_role key (NOT the anon key) so the backend can
# perform admin operations like account deletion and read/write across
# all users for scheduled jobs.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google AI Studio
GEMINI_API_KEY=your-gemini-api-key

# Firebase Admin SDK — path to the service account JSON you download from
# Firebase Console > Project Settings > Service Accounts.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Shared secret required in the X-Job-Secret header for the /jobs/*
# endpoints, so only your scheduler (cron/Cloud Scheduler) can trigger them.
JOBS_SECRET=change-me-to-a-long-random-string
